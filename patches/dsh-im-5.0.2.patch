+      error.code = 'capability-unavailable';
+      throw error;
+    }
+    return await this.#api[method]({
+      baseUrl: this.#config.baseUrl,
+      token: this.#token,
+      toUserId,
+      file,
+      signal: sendSignal,
+    });
